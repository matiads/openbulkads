{
  "name": "openbulkads",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:network": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "start:container": "node scripts/container-start.mjs",
    "migrate:container": "node scripts/container-migrate.mjs",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate --config db/postgres/drizzle.config.ts",
    "db:migrate": "node --experimental-strip-types scripts/db-migrate.mjs",
    "test": "node scripts/test.mjs",
    "test:db": "node --experimental-strip-types --test tests/postgres-schema.test.ts tests/postgres-repositories.test.ts tests/postgres-media-references.test.ts tests/simple-routes.test.ts && node --experimental-strip-types scripts/db-check.mjs",
    "test:large-media": "node scripts/test-large-media.mjs",
    "admin:create": "node --experimental-strip-types scripts/create-admin.mjs",
    "media:cleanup": "node scripts/media-cleanup.mjs",
    "backup": "node scripts/backup-ops.mjs backup",
    "restore": "node scripts/backup-ops.mjs restore"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
