# Clave AES de 32 bytes en base64. Generar localmente; no usar una clave compartida.
TOKEN_ENCRYPTION_KEY=
# Solo desarrollo local con compose.dev.yaml; reemplazar credenciales fuera de desarrollo.
DATABASE_URL=postgresql://openbulkads_dev:local_dev_only@127.0.0.1:5432/openbulkads_dev
# Credenciales dedicadas de migración; solo las usa el contenedor de migración (`--migrate-only`).
# La aplicación en ejecución nunca migra y sigue usando DATABASE_URL.
MIGRATION_DATABASE_URL=
# Better Auth (runtime Node oficial). Generar un secreto aleatorio de al menos 32 caracteres.
# En producción el servidor falla cerrado si BETTER_AUTH_SECRET no está definido.
BETTER_AUTH_SECRET=
# URL base pública de la aplicación, requerida en producción (por ejemplo https://ads.example.internal).
BETTER_AUTH_URL=
# La contraseña del administrador se solicita de forma interactiva en `npm run admin:create`; nunca se lee de variables de entorno.
#
# Límite de media por archivo, en MB enteros (por defecto 250). Se usa igual en el
# navegador y el servidor, así que debe definirse en tiempo de build. Valores
# inválidos, vacíos o no positivos vuelven al default de 250 MB. compose.prod.yaml
# lo reenvía al build y al runtime del contenedor con el mismo valor.
# NEXT_PUBLIC_MEDIA_LIMIT_MB=250
#
# Media privada en disco local del VPS (único backend soportado).
# Ruta absoluta en el VPS, fuera del web root, con permisos restrictivos (por ejemplo /var/lib/openbulkads/media).
MEDIA_ROOT=

# Stack privado de Docker Compose (compose.prod.yaml). No son secretos; los valores
# sensibles se montan como archivos root-only en OPENBULKADS_SECRETS_DIR.
# Dirección del dominio interno; Caddy emite el certificado con su CA interna.
APP_DOMAIN=openbulkads.internal
# Dirección de la interfaz VPN donde Caddy publica HTTPS (obligatoria en producción).
VPN_BIND_ADDRESS=
# Directorio absoluto del host para media privada (uid/gid 1000).
MEDIA_HOST_DIR=/var/lib/openbulkads/media
# Directorio root-only con DATABASE_URL, MIGRATION_DATABASE_URL, BETTER_AUTH_SECRET y TOKEN_ENCRYPTION_KEY.
OPENBULKADS_SECRETS_DIR=./deploy/secrets
